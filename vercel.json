{
    "framework": null,
    "installCommand": "npm ci --include=dev",
    "buildCommand": "npm run build && mkdir -p .vercel-static && cp -R public/build public/favicon.ico public/robots.txt public/*.png .vercel-static/",
    "outputDirectory": ".vercel-static",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "includeFiles": "storage/ca.pem"
        }
    },
    "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
